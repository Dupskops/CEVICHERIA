# --- Google Gemini API ---
GEMINI_API_KEY=tu_api_key_aqui
GEMINI_MODEL=gemini-2.0-flash

# --- Base de Datos PostgreSQL (Supabase) ---
DATABASE_URL=postgresql://user:password@host:5432/cevicheria_db

# --- Configuración de la App ---
DEBUG=True
